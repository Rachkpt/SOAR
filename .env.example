# ══════════════════════════════════════════════════════════════════
#  SOC Automation Pipeline — Modèle de configuration
#
#  UTILISATION :
#      python start.py init      (copie ce fichier vers .env)
#    ou
#      cp .env.example .env      (Linux / macOS)
#      copy .env.example .env    (Windows CMD)
#
#  Puis éditer .env et renseigner au minimum THEHIVE_URL et THEHIVE_APIKEY.
#
#  Astuce : depuis la v8/v11 les commentaires en fin de ligne sont tolérés
#  (« BLOCK_DURATION_MIN=10   # minutes » fonctionne), mais garder une
#  ligne par valeur reste plus lisible.
# ══════════════════════════════════════════════════════════════════


# ─── TheHive ──────────────────────────────────────────────────────
# URL de l'instance TheHive 5. Exemple : http://192.168.1.10:9000
THEHIVE_URL=http://VOTRE_IP:9000

# Clé API TheHive
# Obtenir : TheHive → avatar → Settings → API Keys → Create
THEHIVE_APIKEY=votre_cle_api_thehive_ici

# Vérifier le certificat TLS de TheHive (false si certificat auto-signé)
THEHIVE_VERIFY_SSL=true


# ─── Cortex ───────────────────────────────────────────────────────
# Activer le lancement automatique des analyseurs Cortex
CORTEX_ENABLED=true

# URL de l'instance Cortex. Exemple : http://192.168.1.10:9001
CORTEX_URL=http://VOTRE_IP:9001

# Clé API Cortex — sert de secours si TheHive ne liste pas encore les
# analyseurs (connecteur Cortex pas encore configuré côté TheHive).
# Obtenir : Cortex → Organizations → Users → Create API Key
CORTEX_APIKEY=votre_cle_api_cortex_ici

# Temps d'attente maximum du résultat d'un analyseur, en secondes
CORTEX_JOB_TIMEOUT=180

# Nombre maximum d'analyseurs lancés par observable
CORTEX_MAX_ANALYZERS=5


# ─── MISP ─────────────────────────────────────────────────────────
# Activer le lookup et le partage d'IoC vers MISP
MISP_ENABLED=false

# URL de l'instance MISP. Exemple : https://192.168.1.11
MISP_URL=https://VOTRE_IP_MISP

# Clé API MISP
# Obtenir : MISP → Administration → List Auth Keys → Add authentication key
MISP_APIKEY=votre_cle_api_misp_ici

# Vérifier le certificat TLS de MISP (false pour un certificat auto-signé)
MISP_VERIFY_SSL=false


# ─── VirusTotal ───────────────────────────────────────────────────
# Activer l'enrichissement VirusTotal (IP, hash de fichier, domaine, URL)
VT_ENABLED=true

# Clé API VirusTotal — gratuite : https://www.virustotal.com/gui/join-us
# Quota gratuit : 4 requêtes/minute, 500/jour
VT_APIKEY=votre_cle_api_virustotal_ici

# Timeout des requêtes VirusTotal, en secondes
VT_TIMEOUT=15

# Nombre minimum de moteurs antivirus positifs pour un verdict « malveillant »
VT_MIN_DETECTIONS=2


# ─── Service A — Webhook Splunk ───────────────────────────────────
# Interface d'écoute (0.0.0.0 = toutes les interfaces)
LISTEN_HOST=0.0.0.0

# Port d'écoute du webhook
LISTEN_PORT=5000

# Anti-flood : ignore une alerte strictement identique reçue dans ce délai
# (en secondes). 0 pour désactiver.
RATE_LIMIT_SEC=10

# Nombre de tentatives de création d'alerte TheHive en cas d'échec réseau
RETRY_ATTEMPTS=3

# Délai entre deux tentatives, en secondes
RETRY_DELAY_SEC=5

# Sévérité minimale pour envoyer une notification Telegram / Gmail
# 1 = Low, 2 = Medium, 3 = High, 4 = Critical
NOTIFY_MIN_SEV=1


# ─── Service B — Responder ────────────────────────────────────────
# Fréquence d'interrogation de TheHive, en secondes
POLL_INTERVAL=20

# Sévérité minimale pour qu'une alerte soit traitée
MIN_SEVERITY=1

# Sévérité minimale pour déclencher une réponse active (blocage firewall)
RESPONSE_MIN_SEV=2

# Fichier mémorisant les alertes déjà traitées (relatif → dossier data/)
STATE_FILE=responder_state.json

# Fichier texte lisible listant les IPs bloquées (relatif → dossier data/)
BLACKLIST_FILE=ip_blacklist.txt


# ─── Réponse active — blocage firewall ────────────────────────────
# false → SIMULATION : les blocages sont journalisés mais pas appliqués
# true  → BLOCAGE RÉEL : règles netsh (Windows) ou iptables (Linux)
#         Nécessite PowerShell Administrateur ou sudo/root.
ACTIVE_RESPONSE=false

# Durée d'un blocage, en minutes (déblocage automatique ensuite)
BLOCK_DURATION_MIN=10

# Bloquer les IP responsables d'une attaque par force brute
BLOCK_ON_BRUTEFORCE=true

# Bloquer les IP qui scannent les ports (règles Suricata NMAP -sS/-sT/-sU…)
BLOCK_ON_PORTSCAN=true

# Bloquer toute autre catégorie de menace détectée : exploitation,
# mouvement latéral, vol d'identifiants, rançongiciel, exfiltration…
BLOCK_ON_THREAT=true

# Bloquer aussi les IP privées / internes (10.x, 192.168.x, 172.16.x)
# À laisser sur false en production : bloquer un poste interne le coupe
# entièrement du réseau.
BLOCK_ALL_IPS=false


# ─── Notifications Telegram ───────────────────────────────────────
# Activer les notifications Telegram
TELEGRAM_ENABLED=false

# Token du bot — Telegram → @BotFather → /newbot
# Configuration guidée : python start.py telegram-config
TELEGRAM_TOKEN=

# Chat ID — envoyer /start au bot puis ouvrir :
# https://api.telegram.org/botVOTRE_TOKEN/getUpdates
TELEGRAM_CHAT_ID=


# ─── Notifications Gmail (optionnel) ──────────────────────────────
GMAIL_ENABLED=false

# Adresse Gmail expéditrice
GMAIL_USER=votre.adresse@gmail.com

# Mot de passe d'APPLICATION (pas le mot de passe du compte)
# Générer sur https://myaccount.google.com/apppasswords
# après avoir activé la validation en deux étapes
GMAIL_PASS=

# Destinataire des alertes
GMAIL_TO=destinataire@example.com


# ─── Journaux ─────────────────────────────────────────────────────
# Chemins relatifs → dossier logs/ du projet
LOG_FILE=service_a.log
LOG_FILE_B=service_b.log

# DEBUG, INFO, WARNING, ERROR ou CRITICAL
LOG_LEVEL=INFO
