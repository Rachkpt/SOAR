# ══════════════════════════════════════════════════════════════════
#  SOC Automation Pipeline — .gitignore
# ══════════════════════════════════════════════════════════════════

# --- Configuration sensible — NE JAMAIS COMMITER ---
.env
.env.local
.env.*.local
*.pem
*.key
*.crt
*.p12

# --- Données générées à l'exécution ---
data/
logs/
*.log
ip_blacklist.json
ip_blacklist.txt
responder_state.json

# --- Montages runtime Docker (MISP / Cortex) ---
docker/cortex/logs/
docker/logs/
docker/files/
docker/ssl/
docker/server-configs/

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd
.Python

# --- Environnements virtuels ---
venv/
env/
.venv/
ENV/

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- Système d'exploitation ---
.DS_Store
Thumbs.db
desktop.ini

# --- Distribution / packaging ---
dist/
build/
*.egg-info/
*.egg

# --- Tests ---
tests/.tmp/
tests/.tmp-e2e/
.pytest_cache/
.coverage
htmlcov/

# --- Jupyter ---
*.ipynb_checkpoints
